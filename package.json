{
  "name": "talent-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.dev.vars ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.dev.vars scripts/seed.ts",
    "test:scoring": "tsx scripts/test-scoring.ts",
    "test:authz": "tsx scripts/test-authz.ts",
    "test:pdf": "tsx --conditions=react-server scripts/test-pdf.ts",
    "test:ai": "tsx --conditions=react-server scripts/test-ai.ts",
    "test": "npm run test:scoring && npm run test:authz && npm run test:pdf && npm run test:ai && npm run test:migration && npm run test:embed",
    "test:http": "bash scripts/test-http.sh",
    "test:migration": "tsx --conditions=react-server scripts/test-migration.ts",
    "test:embed": "tsx --conditions=react-server scripts/test-embed.ts",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.dev.vars scripts/db-migrate.ts",
    "test:integration": "tsx --conditions=react-server --env-file-if-exists=.dev.vars scripts/test-integration.ts",
    "db:setup-role": "tsx --conditions=react-server --env-file-if-exists=.dev.vars scripts/db-setup-role.ts",
    "cf:build": "node scripts/check-env-files.mjs && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "db:wsproxy": "node scripts/dev/wsproxy.mjs",
    "check:env": "node scripts/check-env-files.mjs",
    "db:set-passwords": "tsx --conditions=react-server --env-file-if-exists=.dev.vars scripts/set-passwords.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@neondatabase/serverless": "^1.1.0",
    "groq-sdk": "1.5.0",
    "jose": "^6.2.12",
    "next": "15.5.27",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "wrangler": "4.149.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
